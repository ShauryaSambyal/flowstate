# Copy to .env for local development.
# .env is gitignored — never commit it, or your deployed build inherits dev values.

# Backend base URL. Locally this is your server (npm run dev in /server).
# On a host (Vercel/Netlify), set this to your deployed API so the browser does
# not try to reach the visitor's own machine.
VITE_API_URL=http://localhost:8080
# Production:
# VITE_API_URL=https://flowstate-tvmf.onrender.com

# Firebase web config (from Firebase console → Project settings → Your apps).
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_MEASUREMENT_ID=
