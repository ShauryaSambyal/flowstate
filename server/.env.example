[TEMPLATE]
# FlowState server runtime configuration template.
# Copy to .env and fill in real values. Never commit a real .env file.

# --- Core ---
# HTTP listen port for Express (server/server.js). Must match the client's VITE_API_URL.
PORT=
# Runtime environment. Uncomment when needed; Express defaults to development behavior.
# NODE_ENV=development

# --- Browser access ---
# Comma-separated origins allowed to call this API from a browser. Leave empty to
# allow every origin. Set it to your deployed frontend once things are stable.
# CORS_ORIGIN=https://flowstate-two-steel.vercel.app,http://localhost:5173

# --- Database ---
# Full MongoDB connection string consumed by mongoose in src/db.js.
DB_URL=mongodb+srv://user:password@cluster0.mongodb.net/flowstate

# --- AI Providers ---
# Groq SDK key used by /ai/suggestions and chat (src/controllers/ai.controller.js, src/controllers/auth.controller.js).
# Get a key at https://console.groq.com/keys
GROQ_API_KEY=gsk_...
# Groq chat model; falls back to the built-in default when empty. List valid ids via GET https://api.groq.com/openai/v1/models
GROQ_MODEL=
# Reserved: @huggingface/inference fallback key. Uncomment and fill when an HF fallback model is wired up.
# HF_API_KEY=

# --- Email (reserved) ---
# Reserved for nodemailer transactional email (dependency installed, not yet used).
# SMTP_HOST=
# SMTP_PORT=
# SMTP_USER=
# SMTP_PASS=
